    {
      "id": "schema",
      "globs": ["packages/schema/**"],
      "shared_inputs": [
        "package.json",
        "bun.lock",
        "vite.config.ts",
        "tsconfig*.json",
        "knip.json",
        ".bun-version",
        ".node-version",
        "vite.content.config.ts",
        "vite.db.config.ts",
        "AGENTS.md",
        "compose.yaml"
      ],
      "depends_on": []
    },
    {
      "id": "contracts",
      "globs": ["packages/contracts/**"],
      "shared_inputs": [
        "package.json",
        "bun.lock",
        "vite.config.ts",
        "tsconfig*.json",
        "knip.json",
        ".bun-version",
        ".node-version",
        "vite.content.config.ts",
        "vite.db.config.ts",
        "AGENTS.md",
        "compose.yaml"
